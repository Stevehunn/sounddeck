---
import { SITE } from '../i18n/utils'
import { useTranslations, getLocalizedUrl, languages, type Lang } from '../i18n'
import LanguageSwitcher from './LanguageSwitcher.astro'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
    <!-- Logo -->
    <a href={lang === 'fr' ? '/' : `/${lang}/`} class="flex items-center gap-2.5 shrink-0 group">
      <img
        src="/logo-icon.png"
        alt="SoundDeck"
        width="32"
        height="32"
        class="rounded-md transition-transform group-hover:scale-105"
      />
      <span class="font-bold text-[15px] tracking-tight">SoundDeck</span>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden md:flex items-center gap-1">
      <a href="#features" class="px-3 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">
        {t.nav.features}
      </a>
      <a href="#pro" class="px-3 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">
        {t.nav.pro}
      </a>
      <a href="#faq" class="px-3 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors">
        {t.nav.faq}
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener"
        class="px-3 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors flex items-center gap-1.5"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.38.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.8 5.64-5.48 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.56 22.3 24 17.8 24 12.5 24 5.87 18.63.5 12 .5z"/>
        </svg>
        {t.nav.github}
      </a>
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <LanguageSwitcher currentLang={lang} />
      <a
        href={SITE.downloadWindows}
        data-download-btn
        class="hidden sm:inline-flex items-center gap-1.5 px-4 h-9 rounded-[var(--radius-md)] bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-white text-sm font-medium transition-all hover:-translate-y-px hover:shadow-lg hover:shadow-[var(--color-accent)]/30"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        {t.nav.download}
      </a>
    </div>
  </div>
</header>