---
import { SITE } from '../i18n/utils'
import { useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
---

<section class="relative overflow-hidden bg-grid">
  <div class="absolute inset-0 hero-glow pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="flex flex-col items-center text-center">

      <!-- Badge -->
      <a
        href={`${SITE.github}/releases`}
        target="_blank"
        rel="noopener"
        class="animate-fade-in-up inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-secondary)]/60 backdrop-blur-sm text-xs text-[var(--color-text-secondary)] mb-8 hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-bg-secondary)] transition-colors"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] animate-pulse"></span>
        {t.hero.badge}
      </a>

      <!-- Title -->
      <h1 class="animate-fade-in-up text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] mb-6 max-w-4xl">
        <span class="block text-[var(--color-text-primary)]">{t.hero.title_line1}</span>
        <span class="block text-gradient">{t.hero.title_line2}</span>
      </h1>

      <!-- Subtitle -->
      <p class="animate-fade-in-up text-base md:text-lg text-[var(--color-text-secondary)] max-w-2xl mb-10 leading-relaxed">
        {t.hero.subtitle}
      </p>

      <!-- CTAs -->
      <div class="animate-fade-in-up flex flex-col sm:flex-row gap-3 mb-8 w-full sm:w-auto">
        <a
          href={SITE.githubReleases}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-[var(--radius-md)] bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-white font-semibold transition-all hover:-translate-y-0.5 glow-accent"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          {t.hero.cta_primary}
        </a>
        <a
          href={SITE.githubSponsors}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 px-6 h-12 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-secondary)] hover:bg-[var(--color-bg-hover)] hover:border-[var(--color-accent)]/50 text-[var(--color-text-primary)] font-semibold transition-all"
        >
          {t.hero.cta_secondary}
        </a>
      </div>

      <!-- Meta -->
      <div class="animate-fade-in-up flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-[var(--color-text-tertiary)] mb-20">
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.9-1.801"/></svg>
          {t.hero.meta_windows}
        </span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-tertiary)]"></span>
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          {t.hero.meta_macos}
        </span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-tertiary)]"></span>
        <span class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M14.62 8.35c-.42.28-1.75 1.04-1.75 2.61c0 1.9 1.66 2.53 1.69 2.55c-.03.13-.27.94-.9 1.85c-.55.75-1.14 1.55-2.02 1.55c-.87 0-1.1-.51-2.11-.51c-.99 0-1.29.53-2.13.53c-.84 0-1.42-.75-2.06-1.6C4.6 14.51 4 12.9 4 11.38c0-2.53 1.64-3.86 3.24-3.86c.86 0 1.58.56 2.12.56c.53 0 1.34-.6 2.33-.6c.37 0 1.72.04 2.93 1.15zM12.65 3.5c.42-.5.72-1.2.72-1.9c0-.1-.01-.2-.02-.28c-.69.03-1.5.46-1.99 1.03c-.39.44-.75 1.15-.75 1.86c0 .1.02.21.03.25c.07.01.19.02.3.02c.62 0 1.4-.4 1.71-.98z"/></svg>
          {t.hero.meta_linux}
        </span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-tertiary)]"></span>
        <span>{t.hero.meta_free}</span>
        <span class="w-1 h-1 rounded-full bg-[var(--color-text-tertiary)]"></span>
        <span>{t.hero.meta_open_source}</span>
      </div>

    </div>

    <!-- Screenshot flottant en 3D (sans chrome) -->
    <div class="animate-fade-in-up relative max-w-5xl mx-auto" style="animation-delay: 0.2s; perspective: 1600px;">
      <!-- Glow ambiant sous l'image -->
      <div class="absolute inset-x-10 -bottom-8 h-40 bg-[var(--color-accent)]/25 blur-[80px] rounded-full pointer-events-none"></div>

      <!-- Container 3D -->
      <div class="group relative transition-transform duration-700 ease-out will-change-transform"
           style="transform: rotateX(6deg);"
           onmouseover="this.style.transform='rotateX(0deg)'"
           onmouseout="this.style.transform='rotateX(6deg)'">

        <!-- Bordure lumineuse fine -->
        <div class="absolute -inset-px rounded-[var(--radius-xl)] bg-gradient-to-b from-[var(--color-accent)]/40 via-[var(--color-border)] to-[var(--color-border)] pointer-events-none"></div>

        <!-- Image -->
        <div class="relative rounded-[var(--radius-xl)] overflow-hidden bg-[var(--color-bg-secondary)] shadow-2xl shadow-black/60">
          <img
            src="/screenshots/home.png"
            alt="SoundDeck — Bibliothèque de sons"
            width="1920"
            height="1080"
            class="w-full h-auto block"
            loading="eager"
          />
          <!-- Léger voile dégradé en bas pour fondre l'image dans la page -->
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[var(--color-bg-primary)] to-transparent pointer-events-none"></div>
        </div>

      </div>
    </div>

  </div>
</section>