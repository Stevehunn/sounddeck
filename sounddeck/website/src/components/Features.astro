---
import { useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const features = [
  { key: 'editor',       icon: 'ti-wand',            accent: '#7c6ff7' },
  { key: 'sequencer',    icon: 'ti-playlist',        accent: '#1d9e75' },
  { key: 'import',       icon: 'ti-brand-youtube',   accent: '#e05252' },
  { key: 'mixer',        icon: 'ti-microphone',      accent: '#ef9f27' },
  { key: 'integrations', icon: 'ti-plug-connected',  accent: '#7c6ff7' },
  { key: 'i18n',         icon: 'ti-world',           accent: '#1d9e75' },
] as const
---

<section id="features" class="relative py-24 md:py-32 border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6">

    <div
      data-reveal="up"
      class="text-center max-w-2xl mx-auto mb-16"
    >
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4">
        {t.features.title}
      </h2>
      <p class="text-[var(--color-text-secondary)] text-base md:text-lg leading-relaxed">
        {t.features.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f, i) => {
        const item = t.features.items[f.key]
        const delay = Math.min(i * 70, 420)
        return (
          <div
            data-reveal="up"
            data-reveal-delay={delay}
            class="group relative rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-6 hover:border-[var(--color-border-hover)] hover:-translate-y-0.5 transition-all duration-200"
          >
            <div
              class="w-11 h-11 rounded-[var(--radius-md)] flex items-center justify-center mb-5 border"
              style={`background: ${f.accent}15; border-color: ${f.accent}30; color: ${f.accent};`}
            >
              <i class={`ti ${f.icon}`} style="font-size: 22px"></i>
            </div>
            <h3 class="text-base font-semibold mb-2 text-[var(--color-text-primary)]">
              {item.title}
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
              {item.desc}
            </p>
          </div>
        )
      })}
    </div>

  </div>
</section>