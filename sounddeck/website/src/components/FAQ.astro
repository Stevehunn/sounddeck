---
import { useTranslations, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const keys = ['free', 'license', 'voicemeeter', 'os', 'privacy', 'contribute'] as const
---

<section id="faq" class="relative py-24 md:py-32 border-t border-[var(--color-border)]">
  <div class="max-w-3xl mx-auto px-6">

    <div data-reveal="up" class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        {t.faq.title}
      </h2>
    </div>

    <div class="space-y-3">
      {keys.map((key, i) => {
        const item = t.faq.items[key]
        const delay = Math.min(i * 60, 300)
        return (
          <details
            data-reveal="up"
            data-reveal-delay={delay}
            class="group rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-bg-secondary)] overflow-hidden transition-colors hover:border-[var(--color-border-hover)]"
          >
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none select-none">
              <span class="font-medium text-[15px] text-[var(--color-text-primary)]">{item.q}</span>
              <svg
                width="18" height="18" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                class="shrink-0 text-[var(--color-text-tertiary)] transition-transform duration-200 group-open:rotate-180"
              >
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 pt-0 text-sm text-[var(--color-text-secondary)] leading-relaxed">
              {item.a}
            </div>
          </details>
        )
      })}
    </div>

  </div>
</section>