{
  "name": "sounddeck",
  "version": "1.3.0",
  "description": "Soundboard local for Discord or other applications with voice chat",
  "author": "SteveHun <stevehun09@gmail.com>",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "build:plugin": "node scripts/build-plugin.js",
    "migrate": "node scripts/migrate-architecture.js",
    "audit:i18n": "node scripts/audit-i18n.js"
  },
  "build": {
    "appId": "com.sounddeck.app",
    "productName": "SoundDeck",
    "copyright": "SoundDeck 2026",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/noise-suppression.js",
        "to": "noise-suppression.js",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/archiver/**",
      "node_modules/unzipper/**",
      "node_modules/yt-dlp-exec/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundDeck"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "electron-store": "^8.1.0",
    "ffmpeg-static": "^5.3.0",
    "howler": "^2.2.4",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tmi.js": "^1.8.5",
    "tone": "^14.7.77",
    "unzipper": "^0.10.14",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^7.0.1",
    "yt-dlp-exec": "^1.0.2"
  }
}
